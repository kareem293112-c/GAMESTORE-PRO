rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Hardened Primitives ---
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      return isSignedIn() && (
        (request.auth.token.email == 'karmo2931@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      ); 
    }
    function requestTime() { return request.time; }

    // Global Catch-All: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Activity Feed ---
    match /activity/{activityId} {
      allow read: if true;
      allow write: if false;
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin(); // List only for admins
      allow create: if isSignedIn() && request.auth.uid == userId 
                    && incoming().keys().hasAll(['email', 'displayName', 'role', 'createdAt', 'balance'])
                    && incoming().keys().size() == 5
                    && incoming().email == request.auth.token.email
                    && (incoming().role == 'customer' || (incoming().role == 'admin' && request.auth.token.email == 'karmo2931@gmail.com'))
                    && incoming().balance == 0
                    && incoming().createdAt == requestTime();
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin())
                    && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'balance', 'role'])
                    && (incoming().role == existing().role || isAdmin());
    }

    // --- Products Collection ---
    match /products/{productId} {
      allow get: if true;
      allow list: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // --- Orders Collection ---
    match /orders/{orderId} {
      allow get: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn();
      allow create: if isSignedIn() 
                    && incoming().userId == request.auth.uid
                    && incoming().status == 'pending'
                    && incoming().createdAt == requestTime();
      allow update: if isSignedIn() && isAdmin()
                    && incoming().diff(existing()).affectedKeys().hasAny(['status', 'deliveryInfo']);
      
      // Helper for order status
      function isValidStatus(status) {
        return status in ['pending', 'processing', 'delivered', 'cancelled', 'on_hold'];
      }
    }

    // Admins Collection
    match /admins/{userId} {
      allow read: if isAdmin();
      allow write: if false; // Admins managed via console or script
    }

    // --- Reviews Collection ---
    match /reviews/{reviewId} {
      allow list, get: if true;
      allow delete: if isAdmin();
    }
  }
}
