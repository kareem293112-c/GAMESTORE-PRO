{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A digital game or gift card for sale",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "discount": { "type": "number" },
        "stock": { "type": "number" },
        "category": { "type": "string" },
        "platform": { "type": "string" },
        "imageUrl": { "type": "string" },
        "costPrice": { "type": "number", "description": "The price at which the product was purchased by the store" },
        "rating": { "type": "number" },
        "featured": { "type": "boolean" },
        "releaseDate": { "type": "string" },
        "developer": { "type": "string" },
        "languages": { "type": "array", "items": { "type": "string" } },
        "requirements": {
          "type": "object",
          "properties": {
            "os": { "type": "string" },
            "processor": { "type": "string" },
            "memory": { "type": "string" },
            "graphics": { "type": "string" },
            "storage": { "type": "string" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "price", "category", "imageUrl"]
    },
    "Category": {
      "title": "Category",
      "description": "Product category",
      "type": "object",
      "properties": {
        "name": { "type": "string" }
      },
      "required": ["name"]
    },
    "Order": {
      "title": "Order",
      "description": "A purchase made by a user",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "completed", "cancelled"] },
        "paymentMethod": { "type": "string", "enum": ["wallet"] },
        "deliveryInfo": { "type": "string", "description": "Credentials or delivery information for the digital product" },
        "createdAt": { "type": "string", "format": "date-time" },
        "customerEmail": { "type": "string" },
        "customerName": { "type": "string" }
      },
      "required": ["userId", "items", "total", "status", "createdAt"]
    },
    "User": {
      "title": "User Profile",
      "description": "Extended user information",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "customer"] },
        "displayName": { "type": "string" },
        "balance": { "type": "number", "description": "Current wallet balance" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role"]
    },
    "Review": {
      "title": "Review",
      "description": "A user's review for a product",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["productId", "userId", "rating", "createdAt"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Collection of digital products"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Collection of product categories"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Collection of customer orders"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and roles"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Collection of product reviews"
    }
  }
}
